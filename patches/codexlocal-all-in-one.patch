+#[cfg(unix)]
+async fn wait_for_terminal_lifecycle_shutdown() {
+    use tokio::signal::unix::SignalKind;
+    use tokio::signal::unix::signal;
+    use tokio::time::Duration;
+
+    let mut sighup = signal(SignalKind::hangup()).ok();
+    let mut parent_check = tokio::time::interval(Duration::from_secs(1));
+    loop {
+        tokio::select! {
+            _ = async {
+                match sighup.as_mut() {
+                    Some(stream) => { let _ = stream.recv().await; }
+                    None => std::future::pending::<()>().await,
+                }
+            } => return,
+            _ = parent_check.tick() => {
+                // SAFETY: getppid has no preconditions and does not dereference pointers.
+                if unsafe { libc::getppid() } == 1 {
+                    return;
+                }
+            }
+        }
+    }
+}
+
+#[cfg(not(unix))]
+async fn wait_for_terminal_lifecycle_shutdown() {
+    std::future::pending::<()>().await;
+}
